  answer2: {fileID: 1409737824}
  answer3: {fileID: 1665908038}
  answer4: {fileID: 815881875}
  questions:
  - question: "\u554F\u984C\uFF1A\u767C\u751F\u5730\u9707\u6642\uFF0C\u54EA\u500B\u52D5\u4F5C\u662F\u6B63\u78BA\u7684\uFF1F"
    answer: 1
    answer1: "a) \u98DB\u5954\u5230\u5BA4\u5916"
    answer2: "b) \u8EB2\u5728\u684C\u5B50\u4E0B\u6216\u5176\u4ED6\u5805\u56FA\u7684\u7D50\u69CB\u4E0B"
    answer3: "c) \u958B\u9580\u7A97\u4EE5\u6E1B\u8F15\u5EFA\u7BC9\u7269\u7684\u9707\u52D5"
    answer4: "d) \u5FEB\u901F\u8DF3\u51FA\u6A13\u7A97 "
  - question: "\u554F\u984C\uFF1A\u5730\u9707\u767C\u751F\u5F8C\uFF0C\u61C9\u8A72\u505A\u4EC0\u9EBC\u4EE5\u78BA\u4FDD\u5B89\u5168\uFF1F"
    answer: 3
    answer1: "a) \u9032\u884C\u706B\u707D\u6F14\u7DF4"
    answer2: "b) \u6AA2\u67E5\u623F\u5C4B\u7D50\u69CB\u662F\u5426\u53D7\u640D"
    answer3: "c) \u7DCA\u6025\u64A4\u96E2\u5230\u5C71\u5340"
    answer4: "d) \u95DC\u9589\u96FB\u6E90\u8A2D\u5099\u4E26\u958B\u59CB\u96FB\u5668\u6AA2\u67E5"
  - question: "\u554F\u984C\uFF1A\u4F60\u5728\u5730\u9707\u767C\u751F\u5F8C\u767C\u73FE\u81EA\u5DF1\u88AB\u56F0\u5728\u5EFA\u7BC9\u7269\u4E2D\u3002\u4E0B\u5217\u54EA\u9805\u884C\u52D5\u662F\u6700\u5B89\u5168\u7684\uFF1F"
    answer: 3
    answer1: "a) \u7ACB\u5373\u4F7F\u7528\u96FB\u68AF\u9003\u751F"
    answer2: "b) \u547C\u53EB\u5BB6\u4EBA\u901A\u77E5\u4F60\u7684\u4F4D\u7F6E"
    answer3: "c) \u5728\u9580\u53E3\u7B49\u5F85\u6551\u63F4"
    answer4: "d) \u4F7F\u7528\u7C21\u8A0A\u6216\u5176\u4ED6\u975C\u97F3\u65B9\u5F0F\u5411\u5916\u6C42\u6551"
  - question: "\u554F\u984C\uFF1A\u5730\u9707\u767C\u751F\u6642\uFF0C\u4EC0\u9EBC\u884C\u70BA\u6700\u5BB9\u6613\u9020\u6210\u50B7\u5BB3\uFF1F"
    answer: 0
    answer1: "a) \u5728\u6A13\u68AF\u4E0A\u9003\u8DD1"
    answer2: "b) \u8EB2\u5728\u684C\u5B50\u4E0B"
    answer3: "c) \u5728\u5927\u5EC8\u7684\u8D70\u5ECA\u88E1\u7B49\u5F85"
    answer4: "d) \u6436\u6551\u884C\u52D5\u5BB6\u5177"
